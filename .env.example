# Safe defaults for local development only. Use strong secrets in production.
COMPOSE_PROJECT_NAME=oxford-course-discovery

APP_PORT=8080
APP_URL=http://localhost:8080

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
DB_TABLE_PREFIX=wp_

# Isolated database used only by WordPress integration tests.
TEST_DB_NAME=wordpress_test
TEST_DB_USER=wordpress_test
TEST_DB_PASSWORD=wordpress_test
TEST_DB_ROOT_PASSWORD=root

WP_TITLE="Oxford Course Discovery"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=1

# Used by the Composer service to avoid root-owned host files on Linux.
HOST_UID=1000
HOST_GID=1000
